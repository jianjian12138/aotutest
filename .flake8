[flake8]
max-line-length = 120
exclude = */migrations/*,*/static/*,*/node_modules/*
# CI 门禁只拦"真实缺陷"类，忽略遗留风格噪声（W/C/E1-E4/E5-E7 等），
# 这样 flake8 既严格又有意义，避免对历史代码一票否决。
# E9  : 语法/运行时错误（E901/E902/E999）
# E722: 裸 except（安全/健壮性，必须修）
# F811: 名称重定义   F821: 未定义名称   F823: 未定义局部名
# F831: 未使用变量   F841: 未使用（赋值未读）
select = E9,E722,F811,F821,F823,F831,F841
