# 忽略虚拟环境及项目产生的临时文件
.venv/
venv_py311/
venv/
env/
.idea/
.claude/
.vscode/
.trae/
.qoder/
__pycache__/
.DS_Store
.pytest_cache
*.sqlite3
*.log
*.png
llm_debug.txt
logs/*
!logs/.gitkeep

# Python 编译文件
*.py[cod]
*$py.class
*.so
.Python

# 临时文件
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# 忽略所有 app/*/migrations/ 目录下的所有内容 (包括文件和子目录)
apps/*/migrations/*
!apps/*/migrations/__init__.py

# 忽略media下的子目录及文件，但保留.gitkeep文件
media/allure-reports/*
!media/allure-reports/.gitkeep
media/allure-results/*
!media/allure-results/.gitkeep
media/requirement_docs/*
!media/requirement_docs/.gitkeep
media/ai_recording/*
!media/ai_recording/.gitkeep
media/knowledge_docs/*

# 测试缓存
.pytest_cache/
.coverage
htmlcov/

# IDE 配置补充
*.swp
*.swo

# 忽略前端文件
frontend/node_modules/
frontend/.DS_Store
frontend/*.log
frontend/dist/
frontend/.vite/
frontend/build/

# User specific exclusions
scripts/
recorded_script.py
.env
temp/
insert_sample_data.py
debug_sync.py

# Allure 测试报告工具
allure/bin/
allure/lib/
allure/plugins/
!allure/.gitkeep

# ChromaDB 向量数据库
chroma_db/*
