# ============================================================
# 自动化测试平台 — 环境变量模板
# ============================================================
# 使用方法：cp .env.example .env，然后填入真实值。
# 生产部署禁止使用以下任何默认值！

# ---------- Django 核心配置 ----------
# 生产环境必须设为 False
DEBUG=False

# 必须替换为强随机字符串（建议 django.core.management.utils.get_random_secret_key()）
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY

# 允许访问的主机名（生产环境应替换为真实域名）
ALLOWED_HOSTS=localhost,127.0.0.1

# 字段加密密钥（用于 EncryptedTextField，必须为 32 字节 base64 编码）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---------- 数据库配置（PostgreSQL）----------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=testing_platform
DB_USER=testing_user
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# ---------- Redis配置（缓存，可选）----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- django-q2 任务队列 ----------
# 本项目使用 django-q2（ORM broker），不使用 Celery。
# 以下 Q_CLUSTER 配置在 backend/settings.py 中已硬编码，无需环境变量。

# ---------- 邮件配置（可选）----------
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---------- CORS配置 ----------
CORS_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# ---------- AI配置（可选）----------
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=

# ---------- 文件上传配置 ----------
MAX_UPLOAD_SIZE=10485760  # 10MB
