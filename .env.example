# Django配置
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置（PostgreSQL）
DB_ENGINE=django.db.backends.postgresql
DB_NAME=testing_platform
DB_USER=testing_user
DB_PASSWORD=testing_password
DB_HOST=postgres
DB_PORT=5432

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# 邮件配置（可选）
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080

# AI配置（可选）
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=

# 文件上传配置
MAX_UPLOAD_SIZE=10485760  # 10MB
