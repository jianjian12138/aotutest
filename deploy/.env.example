# ===== 数据库配置 =====
POSTGRES_DB=test_platform
POSTGRES_USER=test_user
POSTGRES_PASSWORD=your_secure_password_here

# ===== Django配置 =====
# 生成方式: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production
# 字段加密密钥（凭据加密存储用，独立于 SECRET_KEY，轮换 SECRET_KEY 不影响已加密数据）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===== Redis配置（缓存，可选；任务队列使用 django-q2 ORM broker，不依赖 Redis）=====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== 管理员初始化（create_admin.py 使用；不设置则自动生成随机强口令并打印一次）=====
ADMIN_PASSWORD=

# ===== AI 服务密钥（按需）=====
DEEPSEEK_API_KEY=

# ===== 邮件配置（用于通知）=====
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True

# ===== 安全配置（启用 HTTPS 后置 True）=====
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ===== 前端配置 =====
VITE_API_BASE_URL=https://api.your-domain.com
